# URL base do seu WAHA (sem barra no final). No EasyPanel, pode ser o nome interno do serviço
# na mesma rede, ex.: http://waha:3000, ou a URL pública, ex.: https://waha.seudominio.com
WAHA_API_URL=http://waha:3000

# Mesmo valor configurado em WAHA_API_KEY no container do WAHA
WAHA_API_TOKEN=troque-por-uma-chave-segura

# Porta em que esta aplicação recebe os webhooks
PORT=3000

# --- Opcionais ---
# Nome da sessão no WAHA (padrão: default)
WAHA_SESSION=default
# Chave HMAC para validar webhooks (mesma de WHATSAPP_HOOK_HMAC_KEY no WAHA)
WAHA_WEBHOOK_HMAC_KEY=
# Texto da resposta automática
REPLY_TEXT=Olá! Como posso ajudar?
# Responder também em grupos (true/false)
REPLY_IN_GROUPS=false
